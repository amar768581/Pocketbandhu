{
  "name": "pocketbandhu",
  "version": "2.0.0",
  "description": "Pocketbandhu - an AI Calling Agent built with Hono, Twilio Voice and Google Gemini. Runs on Cloudflare Workers (Sites) and on Node (Render).",
  "main": "server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "esbuild worker.js --bundle --format=esm --platform=browser --target=es2022 --conditions=workerd --outfile=dist/worker.js",
    "dev:workers": "npm run build && wrangler dev --config wrangler.jsonc"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "twilio",
    "voice",
    "gemini",
    "hono",
    "cloudflare-workers",
    "ai-agent",
    "bengali",
    "hindi"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^16.6.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.156.0"
  }
}
