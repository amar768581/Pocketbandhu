# ---------------------------------------------------------------------------
# Pocketbandhu - environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Twilio (https://console.twilio.com) -----------------------------------
# Account SID  -> Dashboard "Account SID"
# Auth Token   -> Dashboard "Auth Token" (click to reveal)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# The Twilio number that will place the outbound calls (E.164 format).
# Trial accounts can only call verified caller IDs.
TWILIO_PHONE_NUMBER=+15005550006

# --- Google Gemini (https://aistudio.google.com/apikey) --------------------
GEMINI_API_KEY=your_gemini_api_key

# Public base URL of this server, no trailing slash.
# Local dev: your ngrok URL, e.g. https://abc123.ngrok-free.app
# Render:    https://your-service.onrender.com
PUBLIC_URL=https://your-service.onrender.com

# --- Optional tuning -------------------------------------------------------
# Fast default model. gemini-3.8-flash is the current standard fast model.
GEMINI_MODEL=gemini-3.8-flash

# Twilio speech recognition model used by <Gather input="speech">.
# googlev2_telephony supports bn-IN, hi-IN and en-IN.
GATHER_SPEECH_MODEL=googlev2_telephony

# Seconds of silence Twilio waits before treating the caller as finished.
# Must be an integer when GATHER_SPEECH_MODEL is set. Use "5" for slower
# callers, "3" for snappier turns.
GATHER_SPEECH_TIMEOUT=4

# HTTP port (Render sets PORT automatically).
PORT=3000
